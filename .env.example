# Required for Outstand webhook HMAC verification (autopost webhook receiver).
# Set the same value in local .env and in production. Do not commit real secrets.
OUTSTAND_WEBHOOK_SECRET=replace-with-your-outstand-webhook-secret

# Langfuse — LLM tracing/observability for the RAG chat pipeline (src/rag).
# Sign up at https://cloud.langfuse.com (or self-host), create a project, and
# copy its API keys here. If left blank, span export just fails in the
# background (logged, not thrown) — the app runs fine either way.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-replace-with-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
