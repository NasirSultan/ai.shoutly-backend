# Required for Outstand webhook HMAC verification (autopost webhook receiver).
# Set the same value in local .env and in production. Do not commit real secrets.
OUTSTAND_WEBHOOK_SECRET=replace-with-your-outstand-webhook-secret

# Langfuse — LLM tracing/observability for the RAG chat pipeline (src/rag).
# Sign up at https://cloud.langfuse.com (or self-host), create a project, and
# copy its API keys here. If left blank, span export just fails in the
# background (logged, not thrown) — the app runs fine either way.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-replace-with-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Razorpay — real payments for /subscription/create-order + /subscription/verify.
# Dashboard → Account & Settings → API Keys. Use rzp_test_ keys locally, rzp_live_ in production.
RAZORPAY_KEY_ID=rzp_test_replace-with-your-key-id
RAZORPAY_KEY_SECRET=replace-with-your-key-secret
# Dashboard → Webhooks → URL https://<your-api>/api/subscription/webhook/razorpay,
# events: payment.captured, payment.failed, order.paid. Paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret

# X, TikTok, and Bluesky. Do not commit real secrets.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://backend.shoutlyai.com/api/x/callback
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://backend.shoutlyai.com/api/tiktok/callback
# Bluesky OAuth (AT Protocol). Generate the key once: node scripts/generate-bluesky-key.js
# Never replace BLUESKY_PRIVATE_JWK without keeping the old public key published, or every
# connected Bluesky account has to reconnect. Leave it empty on localhost to use the
# loopback dev client (FRONTEND_URL must contain localhost).
BLUESKY_PRIVATE_JWK=
BLUESKY_CLIENT_ID=https://backend.shoutlyai.com/api/bluesky/client-metadata.json
BLUESKY_REDIRECT_URI=https://backend.shoutlyai.com/api/bluesky/callback
BLUESKY_JWKS_URI=https://backend.shoutlyai.com/api/bluesky/jwks.json
BLUESKY_SCOPE=atproto transition:generic
# Optional: resolve handles through this service instead of DNS/HTTPS lookups.
BLUESKY_HANDLE_RESOLVER=https://bsky.social
# 32-byte key (openssl rand -base64 32) that encrypts stored OAuth sessions.
TOKEN_ENCRYPTION_KEY=

# Sentry error tracking (Sentry project > Settings > Client Keys). Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Who receives system alert emails (comma-separated)
ALERT_EMAILS=you@example.com
