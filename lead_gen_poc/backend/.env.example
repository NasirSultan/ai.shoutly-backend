PORT=4100
CORS_ORIGIN=http://localhost:3100

# docker compose up -d  (see docker-compose.yml)
DATABASE_URL=postgresql://leadfinder:leadfinder@localhost:5433/leadfinder
REDIS_URL=redis://localhost:6380

# Apify: runs the Reddit and Facebook search actors
APIFY_TOKEN=apify_api_xxx
# true = read posts from samples/*.json instead of calling Apify (no credits used)
APIFY_MOCK=false

# OpenRouter: classifies posts (lead label, intent score, sentiment).
# Comma-separated fallback list, tried in order. Free models come and go (check
# https://openrouter.ai/models?q=free). The first one is a
# paid model at well under $0.001 per fetch: free models are often rate-limited or very slow.
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Lead finder tuning
LEAD_FINDER_FRESH_MINUTES=30        # how long a query's cached results count as fresh
LEAD_FINDER_MIN_SCORE=50            # genuine leads below this intent score are not shown
LEAD_FINDER_MIN_RELEVANCE=50        # ...or below this relevance to the profile keywords
LEAD_FINDER_REDDIT_LIMIT=100        # posts fetched per Reddit search (the Reddit actor is free)
LEAD_FINDER_FACEBOOK_LIMIT=10       # posts fetched per Facebook search query
LEAD_FINDER_FACEBOOK_QUERIES=2      # max keywords searched on Facebook per profile
LEAD_FINDER_USER_FETCHES_PER_MIN=4  # per-user "Get leads" limit
LEAD_FINDER_APIFY_CALLS_PER_HOUR=30 # global cap on Apify runs, per platform

# No sign-in in the POC: every request acts as this user.
# In ai.shoutly-backend this is replaced by AuthGuard + req.user.
LEAD_FINDER_DEMO_USER_ID=demo-user
